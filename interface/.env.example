# Mastra credix backend. Server-side only (used by app/api/chat/route.ts).
# The browser talks to the same-origin /api/chat proxy, never this URL directly.
CREDIX_API_URL=http://localhost:3000

# ElevenLabs speech-to-text (used server-side by app/api/stt/route.ts for voice input).
# Same key as the backend .env. The browser posts audio to /api/stt, never to ElevenLabs.
ELEVENLABS_API_KEY=
# Optional STT model override (default: scribe_v2).
ELEVENLABS_STT_MODEL=scribe_v2

# ElevenLabs text-to-speech (used server-side by app/api/tts/route.ts to read replies aloud).
# Uses the same ELEVENLABS_API_KEY above. The browser posts reply text to /api/tts and gets audio.
# Optional voice + model overrides (defaults: George voice, eleven_turbo_v2_5).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
