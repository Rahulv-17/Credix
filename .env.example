# Credit Credix — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real values.

# ── Data plane ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/        # L2 store (Atlas): bureau_data + user_story
MONGODB_DB=consumer
REDIS_URL=redis://localhost:9401                          # L1 cache (Pogocache; plain RESP, also Redis/Valkey)
REDIS_TTL=86400                                           # serving-cache TTL, seconds
STORY_TTL=86400                                           # persona/user-story cache TTL, seconds (defaults to REDIS_TTL)
BUREAU_FRESH_DAYS=15                                       # Mongo L2 freshness window
# For prod: run Pogocache with --auth <pw> and use REDIS_URL=redis://:<pw>@host:9401

# ── Snowflake (L3 source of truth) ──────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<account_locator>
SNOWFLAKE_USER=<your_user>
SNOWFLAKE_ROLE=BUREAU_DATA_READONLY
SNOWFLAKE_WAREHOUSE=B2C_APP_WH
SNOWFLAKE_DATABASE=BUREAU_DATA
SNOWFLAKE_SCHEMA=BUREAU_DATA
# Pick ONE auth method (tried in order: PAT -> password -> key-pair/JWT):
# SNOWFLAKE_PAT=
# SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_FILE=<abs path to keys/rsa_key.p8>
# SNOWFLAKE_PRIVATE_KEY_PWD=          # only if the key is encrypted

# ── LLM ─────────────────────────────────────────────────────────────────────────
# Provider is chosen by the MASTER_MODEL / WORKER_MODEL prefix ("provider/model", Mastra model router),
# so switching provider is an env edit, not a code change. Set the key for whichever provider you point at.
XAI_API_KEY=                             # xAI key (default provider); used by master + workers + OM
GEMINI_API_KEY=                          # Google AI key; only needed if you switch to google/*, forwarded to GOOGLE_GENERATIVE_AI_API_KEY
MASTER_MODEL=xai/grok-4.5                       # supervisor model (routing + user-facing synthesis)
WORKER_MODEL=xai/grok-4.20-0309-non-reasoning   # worker + OM Observer/Reflector model
# Other ids live on the xAI key: grok-4.20-0309-reasoning, grok-4.20-multi-agent-0309, grok-4.3,
# grok-build-0.1 (coding). Google alternative: google/gemini-3.1-pro-preview + google/gemini-3.5-flash.

# ── TypeScript / Mastra layer ──────────────────────────────────────────────────
MASTRA_DB_URL=file:./mastra.db           # LibSQL storage path for Mastra memory
PORT=3000                                # Hono server port (must NOT be 2024)

# ── Observational Memory (OM) ───────────────────────────────────────────────────
# OM's Observer/Reflector reuse WORKER_MODEL and its provider key; no separate provider key needed.
OM_SCOPE=thread                          # thread (default) | resource (experimental cross-session)
OM_MESSAGE_TOKENS=30000                  # Observer trigger: unobserved message tokens
OM_OBSERVATION_TOKENS=40000              # Reflector trigger: observation tokens
OM_ASYNC_BUFFER=true                     # false = run the Observer synchronously (used by om.live.test)

# ── Internal services ─────────────────────────────────────────────────────────
BUREAU_SIDECAR_URL=http://localhost:8000      # Python data sidecar base URL
INTERNAL_API_SECRET=change-me-in-production  # shared secret for /internal/* routes — REQUIRED
BUREAU_CACHE_TTL_MS=900000                    # per-user in-process reuse window for the bureau profile; 0 disables (always fetch)

# ── Card catalog (Cred credit-card tools) ──────────────────────────────────────
# Postgres connection for the card catalog + reward-ranking SQL that the credit-card tools read.
# First cut reuses Cred's Supabase catalog directly; copy DATABASE_URL from Cred/.env. Swap for a
# Credix-owned catalog later without touching the tools. Unset => card tools fail soft
# ("catalog not configured"); the rest of the app is unaffected.
DATABASE_URL=postgres://<user>:<pass>@<host>:6543/postgres   # Supabase pooler (port 6543) or 5432 direct
# TLS to Supabase's pooler is unverified by default in dev/test (encrypted, not authenticated).
# In production the pool refuses to start unless you make an explicit choice below. Set ONE of:
# DB_SSL_CA=<abs path to supabase-ca.crt>     # verify against the bundled Supabase CA (the real fix)
# DB_SSL_VERIFY=1                              # verify against the system CA store
# DB_SSL_INSECURE=1                           # explicitly allow unverified TLS; only needed in
#                                             # production, and only if you deliberately skip CA/VERIFY

# ── Exa (live web search) ───────────────────────────────────────────────────
EXA_API_KEY=                                 # required for exaSearch tool (web search across all agents)

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=                          # required for STT (decode step) and TTS (compose step)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb    # optional — Rahul persona voice (default: George)

# ── Observability (OpenTelemetry -> Honeycomb) ──────────────────────────────────
OTEL_SERVICE_NAME=credix-mastra
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io   # or http://localhost:4318 for a local collector
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<INGEST_KEY>  # required for api.honeycomb.io
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Tracing is ON by default when the server runs via `dev` (loads tracing.ts). It degrades gracefully
# (no export, no error spam) if the endpoint/headers above are unset. Use `dev:untraced` to disable.
# Live-run tuning: how often the batch processor flushes spans (ms). Lower = spans appear in Honeycomb
# sooner while chatting; default is 5000. 2000 is a good balance for watching a live run.
OTEL_BSP_SCHEDULE_DELAY=2000
# Capture per-stage input/output on spans. OFF by default (PII rule). When =1, payloads are
# truncated, tts audio is compressed, and PAN/Aadhaar/mobile are auto-redacted before export.
OTEL_CAPTURE_IO=0

# ── LLM tracing (Mastra AI tracing -> Langfuse) ────────────────────────────────
# Separate from the OTel->Honeycomb pipeline above: this gives the agent/workflow/tool/generation
# view (model + tokens + Agent Graph) in Langfuse. OFF unless ALL THREE vars below are set; until then
# nothing leaves the process. The base URL is gated too, not just the keys: unset, the SDK would default
# to the public Langfuse Cloud host, so keys without a URL mean tracing OFF rather than an export to an
# instance nobody chose. Prompts/tool I/O are exported with mobile/PAN/Aadhaar redacted inside the text
# (SensitiveDataFilter + scrubIdentifiers), BUT the trace-level Langfuse user id is the raw mobile by
# explicit decision (2026-07-30), so the target instance holds PII: use a self-hosted or HIPAA-tier
# Langfuse, never the shared cloud. Today this points at the HIPAA cloud deployment.
LANGFUSE_PUBLIC_KEY=                          # pk-lf-... from Langfuse Settings > API Keys
LANGFUSE_SECRET_KEY=                          # sk-lf-...
LANGFUSE_BASE_URL=                            # self-hosted URL, e.g. https://langfuse.internal.example

# ── Integration tests (optional) ─────────────────────────────────────────────
TEST_AUDIO_URL=                              # public audio URL for decode STT integration test
TEST_MOBILE=                                 # 10-digit mobile with a real bureau record for pre-guardrail test
